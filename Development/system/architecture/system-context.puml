@startuml system_context
!pragma layout smetana
skinparam shadowing false
skinparam component {
 BackgroundColor<<optional>> #EEEEEE
 BorderColor<<optional>> #888888
 FontColor<<optional>> #666666
}
skinparam artifact {
 BackgroundColor<<optional>> #EEEEEE
 BorderColor<<optional>> #888888
 FontColor<<optional>> #666666
}
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
title System context
left to right direction
actor "Operator" as operator
actor "Patient / sound source" as source
actor "Phone browser" as phone
rectangle "Digital stethoscope" as device
database "FHIR server" as fhir
cloud "Network / time" as net
source --> device : sound
operator --> device : controls
device --> operator : audio / optional display
device --> fhir : BPM Observation (Device, no patient)\nWi-Fi / HTTPS
fhir --> device : status (receipt)
net --> device : connectivity / time
phone --> device : Wi-Fi network + password\nhotspot page (Idle only)
device --> fhir : Device registration\n(once, id kept in flash)
legend bottom
  Grey / optional = beyond MVP.
  Display, touch, SD and capture / slower replay are optional.
endlegend
@enduml
