@startuml measurement_workflow
skinparam shadowing false
skinparam defaultFontName SansSerif
title MVP BPM session
start
:Start Heart session;
if (Heart + microphone + audio ready?) then (yes)
 :Freeze point / analysis settings;
 repeat
  :Stream independent BPM analysis while listening;
  :Reject identity changes with normal fault;
  if (Essential audio fault?) then (yes)
   :Mute and latch Error;
   :Short press clears it once the cause is gone;
   stop
  endif
 repeat while (Stop pressed?) is (no) not (yes)
 :Mute listening;
 if (Duration less than 15 seconds?) then (yes)
  :Cancel measurement, no send;
  stop
 endif
 :Indicate Busy; reject Start without queuing;
 :Aggregate retained valid estimates and interval;
 if (Invalid BPM?) then (yes)
  :Latch normal BPM fault; no numeric value;
 endif
 if (Wi-Fi configured?) then (yes)
  if (Device id / clock / trust / endpoint ready?) then (yes)
   if (Valid BPM?) then (yes)
    :One HTTPS/FHIR numeric result attempt;
   else (no)
    :One error report using validated server contract;
    :Never transmit numeric BPM;
   endif
   if (Receipt 201 / 200?) then (yes)
    :Delivery received;
   else (no)
    :Retry up to 3 times within 10 s;
    :If still failing: latch normal fault;
   endif
  else (no)
   :Latch configured-delivery normal fault;
  endif
 else (no)
  :No send attempt or Wi-Fi error;
 endif
else (no)
 :Reject command;
endif
:Release Busy and network lease;
:Idle; separate manual error acknowledgement;
stop
legend bottom
  Streaming BPM requires no saved raw-session audio.
  Duration/windows/filter/quality targets remain proposals.
  Lung = listening only; no measurement/FHIR/error report.
endlegend
@enduml
