@startuml listening_workflow
skinparam shadowing false
skinparam defaultFontName SansSerif
title Listening
start
:Idle;
:Start listening;
repeat
 if (Lung mode or Raw selected?) then (yes)
  :Bypass filter;
 else (no)
  :Apply selected filter;
 endif
 :Apply volume;
 :Play audio;
 if (Optional replay enabled + Heart mode + capture request?) then (yes)
  #EEEEEE:Record + listen (optional);
  if (Cancelled / source or mode changed?) then (yes)
   #EEEEEE:Discard clip (optional);
  else (clip full)
   #EEEEEE:Replay clip at selected slower speed (optional);
   #EEEEEE:End / cancel (optional);
  endif
 endif
 :Update settings;
repeat while (Stop / fault?) is (no) not (yes)
:Mute;
:Idle / Fault;
stop
legend bottom
  Grey / optional = beyond MVP.
  Display, touch, SD and capture / slower replay are optional.
endlegend
@enduml
