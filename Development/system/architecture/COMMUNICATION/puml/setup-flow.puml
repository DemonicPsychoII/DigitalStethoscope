@startuml setup_flow
!theme cyborg
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
title L2_COMMUNICATION provisioning flow
start
if (Boot with usable saved network?) then (yes)
 :Ask L1_WIFI to join; await selected-network address;
 if (Connected?) then (yes)
  :Return connection outcome to L2_CONTROL;
  stop
 endif
 :Report boot failure; release partial setup resources;
 :Return outcome to L2_CONTROL; manual setup required in Idle;
 stop
endif
:Scan through L1_WIFI and publish completed cache;
if (Scan and hotspot start succeed?) then (yes)
 :Start L1_PORTAL after L1_WIFI hotspot/address service;
 while (Setup session open?) is (yes)
  :Read typed page requests; publish progress;
  if (Connect requested?) then (yes)
   :Join through L1_WIFI; await selected-network address;
   if (Connected?) then (yes)
    :Commit credentials through L1_STORAGE;
    :Publish success or save warning;
    :Close setup session;
   else (failed)
    :Publish cause; refresh selection through a new scan;
   endif
  else (Cancel or inactivity)
   :Close setup session;
  endif
 endwhile (no)
 :Publish Closing before teardown;
 :Stop L1_PORTAL and hotspot services; retain established station;
else (failed)
 :Report cause; release partial setup resources;
endif
:Return outcome to L2_CONTROL;
stop
@enduml
