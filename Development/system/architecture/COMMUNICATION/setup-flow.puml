@startuml setup_flow
!theme cyborg
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
title L2_COMMUNICATION provisioning flow
start
if (Usable saved network?) then (yes)
 :Ask WIFI to join; await selected-network address;
 if (Connected?) then (yes)
  :Return connection outcome to CONTROL;
  stop
 endif
 :Report boot failure; await manual setup request in Idle;
 stop
endif
:Scan through WIFI and publish completed cache;
if (Scan and hotspot start succeed?) then (yes)
 :Start PORTAL after WIFI hotspot/address service;
 :Read typed page requests; publish progress;
 if (Connect requested?) then (yes)
  :Join through WIFI; await selected-network address;
  if (Connected?) then (yes)
   :Commit credentials through STORAGE;
   :Publish success or save warning;
  else (failed)
   :Publish cause; refresh selection through a new scan;
   stop
  endif
 else (Cancel or inactivity)
  :Publish closing;
 endif
 :Stop PORTAL and hotspot services; retain established station;
else (failed)
 :Report cause; release partial setup resources;
endif
:Return outcome to CONTROL;
stop
@enduml
