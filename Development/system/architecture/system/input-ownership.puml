@startuml input_ownership
!theme cyborg
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
skinparam componentStyle rectangle
skinparam package {
 BackgroundColor #111826
 BorderColor #a9b8ca
 FontColor #e6edf7
}
title Input ownership: contact handling, policy and commanded effects
left to right direction

package "Physical contact" {
 rectangle "Start/Stop button" as Button
 rectangle "Raw/Murmur/BPM switch" as Switch
 rectangle "Volume potentiometer" as Potentiometer
}

package "L1_PHYSICALINTERFACE: contact handling" {
 rectangle "Debounce contact levels\nDetect long press once while held\nRelease after a long press is not a short press" as ButtonAdapter
 rectangle "Stable-state reconciliation:\nreport the settled switch position and volume;\non input-queue overflow: reconcile stable values,\nreject and report transient actions" as StableAdapter
}

package "L2_CONTROL: policy" {
 rectangle "Long press in Idle -> setup request\nLong press outside Idle -> rejected" as LongPressPolicy
 rectangle "Short press: Start/Stop admission,\nBusy during analysis,\ncancels a running delivery,\nerror acknowledgement" as ShortPressPolicy
 rectangle "Filter and volume:\napplied as settings,\nalso while listening" as SettingPolicy
}

package "Commanded effects" {
 rectangle "L2_COMMUNICATION\nWi-Fi setup workflow" as SetupEffect
 rectangle "RGB status light\ndims briefly on a rejected input" as RejectEffect
 rectangle "L2_AUDIO\nlisten, measure, filter, volume" as AudioEffect
 rectangle "L2_COMMUNICATION\nnetwork lease release" as LeaseEffect
 rectangle "Red button LED\nerror code, acknowledgement flash" as RedEffect
}

Button --> ButtonAdapter : GPIO edge
Switch --> StableAdapter : GPIO levels
Potentiometer --> StableAdapter : ADC samples
ButtonAdapter --> LongPressPolicy : long press
ButtonAdapter --> ShortPressPolicy : short press
StableAdapter --> SettingPolicy : settled value
LongPressPolicy --> SetupEffect : setup request
LongPressPolicy --> RejectEffect : rejected
ShortPressPolicy --> AudioEffect
ShortPressPolicy --> LeaseEffect
ShortPressPolicy --> RedEffect
SettingPolicy --> AudioEffect

legend bottom left
 L1_PHYSICALINTERFACE decides what a contact means physically (stable level, press duration);
 L2_CONTROL alone decides whether it is admitted; effects never read contacts directly.
endlegend
@enduml
