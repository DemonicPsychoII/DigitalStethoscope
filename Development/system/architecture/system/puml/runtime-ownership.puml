@startuml runtime_ownership
!theme cyborg
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
skinparam component {
 FontColor #0b1018
 BackgroundColor<<optional>> #273241
 BorderColor<<optional>> #61738a
 FontColor<<optional>> #b8c4d4
}
skinparam artifact {
 BackgroundColor<<optional>> #273241
 BorderColor<<optional>> #61738a
 FontColor<<optional>> #b8c4d4
}
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
title Threads
top to bottom direction
skinparam component {
 BackgroundColor<<thread>> #DCEBFA
 BorderColor<<thread>> #345E87
 FontColor<<thread>> #0b1018
 BackgroundColor<<interrupt>> #F0E5CF
 FontColor<<interrupt>> #0b1018
}
component "GPIO ISR" as irq <<interrupt>>
component "L1_PHYSICALINTERFACE\nGPIO / ADC adapters" as adapters
component "Input\nButtons / switches\nSystem work queue" as inp <<thread>>
component "Shell\nL2_SHELL" as shell <<thread>>
component "Main / controller\nL2_CONTROL" as ctl <<thread>>
component "Audio · L2_AUDIO\nL1_I2S RX / TX, L1_FILTER" as audio <<thread>>
component "BPM worker · L2_AUDIO\nL1_FILTER, L1_BPM\nWindow / aggregation" as bpm <<thread>>
component "Communication\nL2_COMMUNICATION\nL1_FHIR, L1_WIFI, L1_PORTAL,\nL1_STORAGE" as net <<thread>>
irq --> inp : wake-up
adapters --> inp : input samples
inp --> ctl : control events
shell --> ctl : control events
ctl --> shell : state
ctl --> audio : settings and commands
audio --> bpm : original-rate sample blocks\nbefore filter and volume
bpm --> ctl : BPM result
audio --> ctl : completion and fault events
ctl --> net : network lease and finalized BPM result
net --> ctl : lease release and delivery outcome
@enduml
