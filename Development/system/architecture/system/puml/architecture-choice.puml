@startuml architecture_choice
!theme cyborg
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
skinparam component {
 BackgroundColor<<optional>> #273241
 BorderColor<<optional>> #61738a
 FontColor<<optional>> #b8c4d4
}
skinparam artifact {
 BackgroundColor<<optional>> #273241
 BorderColor<<optional>> #61738a
 FontColor<<optional>> #b8c4d4
}
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
title Architecture
top to bottom direction
component "Layers\n• Application orchestrates the work\n• Services: hardware adapters, C libraries\n• Zephyr drivers are the bottom layer" as layers #1c4036
component "RTOS threads\n• Workers run separately\n• Audio keeps moving\n• Messages coordinate work" as rt #1c4036
component "Events\n• Inputs become commands\n• Controller owns settings\n• Workers return results" as events #1c4036
component "Superloop (not used)\n• Unsuitable for concurrent audio streaming" as loop #492a34
component "AUTOSAR (not used)\n• Setup effort exceeds device scope" as auto #492a34
component "Task isolation (optional)\n• Optional memory-domain protection" as mpu #273241
layers -[hidden]right-> rt
rt -[hidden]right-> events
layers -[hidden]down-> loop
rt -[hidden]down-> auto
events -[hidden]down-> mpu
loop -[hidden]right-> auto
auto -[hidden]right-> mpu
component "A/B firmware\n• Not included" as ab #273241
auto -[hidden]down-> ab
legend bottom
  Green = used architecture pattern.
  Red = alternative not used.
  Grey = optional or excluded.
endlegend
@enduml
