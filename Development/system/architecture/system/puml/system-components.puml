@startuml system_components
!theme cyborg
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
skinparam database {
 FontColor #0b1018
}
skinparam component {
 FontColor #0b1018
}
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
title System components
left to right direction
component "Chestpiece" as chest
component "INMP441\nMicrophone" as mic
node "ESP32-S3" as cpu
component "PCM5102A\nDAC" as dac
component "Headphone amplifier\n(outside the device boundary)" as amp <<external>>
component "Headphones" as hp <<external>>
component "Button / switch\nPotentiometer / lights" as controls
database "FHIR server" as server <<external>>
chest --> mic : sound
mic --> cpu : microphone I2S link
cpu --> dac : DAC I2S link
dac --> amp : analog audio
amp --> hp : analog audio
controls --> cpu : controls
cpu --> controls : status
cpu --> server : Wi-Fi / HTTPS
server --> cpu : status (receipt)
@enduml
