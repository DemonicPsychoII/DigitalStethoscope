@startuml electrical_interfaces
!theme cyborg
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
skinparam component {
 FontColor #0b1018
 BackgroundColor<<optional>> #273241
 BorderColor<<optional>> #61738a
 FontColor<<optional>> #b8c4d4
}
skinparam artifact {
 BackgroundColor<<optional>> #273241
 BorderColor<<optional>> #61738a
 FontColor<<optional>> #b8c4d4
}
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
title Electrical interfaces
left to right direction
component "INMP441\nMic" as mic
component "PCM5102A\nDAC" as dac
node "ESP32-S3" as cpu
component "Button / switches" as controls
component "Potentiometer" as pot
component "Red button light" as buttonLight
component "RGB status light" as statusLight
mic --> cpu : microphone I²S link
cpu --> dac : DAC I²S link
controls --> cpu : GPIO
pot --> cpu : ADC
cpu --> buttonLight : GPIO
cpu --> statusLight : WS2812 data line
@enduml
