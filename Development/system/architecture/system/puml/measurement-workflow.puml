@startuml measurement_workflow
!theme cyborg
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
skinparam activity {
 FontColor #0b1018
 DiamondFontColor #e6edf7
}
title BPM measurement
start
:Start Heart session;
if (Heart + microphone + audio ready?) then (yes)
 :Freeze the session context and the analysis settings;
 repeat
  :Stream independent BPM analysis while listening;\nno session audio is saved;
  :Reject identity changes;
  :If the session context changes: latch silently, keep listening;\nhalt after the manual Stop, discard the result, restart required;
  if (Audio fault?) then (yes)
   :Mute and latch Error;
   :Block every input until restart;
   stop
  endif
 repeat while (Stop pressed?) is (no) not (yes)
 :Mute listening;
 if (Duration below minimum session length?) then (yes)
  :Cancel measurement, no send;
  stop
 endif
 :Indicate Busy during analysis; reject Start without queuing.\nStart during sending cancels the delivery; the result is lost;
 :Aggregate retained valid estimates and interval;
 if (Invalid BPM?) then (yes)
  :Latch BPM fault; no numeric value;
 endif
 if (Wi-Fi configured?) then (yes)
  if (Device id / server profile image ready?) then (yes)
   if (Valid BPM?) then (yes)
    :One HTTPS/FHIR numeric result attempt;
   else (no)
    :One HTTPS/FHIR error report attempt;
    :Never transmit numeric BPM;
   endif
   if (Server receipt?) then (yes)
    :Delivery received;
   else (no)
    :Retry up to 3 times within the delivery deadline;
    :If still failing: latch delivery fault;
   endif
  else (no)
   :Latch delivery-not-possible fault;
  endif
 else (no)
  :No send attempt and no Wi-Fi error;
 endif
else (no)
 :Reject command;
endif
:Release Busy and network lease;
:Idle; separate manual error acknowledgement;
stop
legend bottom
  Wi-Fi-only failures preserve functioning audio.
endlegend
@enduml
