@startuml electrical_interfaces
!theme cyborg
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
skinparam component {
 BackgroundColor<<optional>> #273241
 BorderColor<<optional>> #61738a
 FontColor<<optional>> #b8c4d4
}
skinparam artifact {
 BackgroundColor<<optional>> #273241
 BorderColor<<optional>> #61738a
 FontColor<<optional>> #b8c4d4
}
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
title Electrical interfaces
left to right direction
component "INMP441\nMic" as mic
component "PCM5102A\nDAC" as dac
node "ESP32-S3" as cpu
component "ILI9341\nDisplay" as display <<optional>>
component "XPT2046\nTouch" as touch <<optional>>
artifact "SD card" as sd <<optional>>
component "Shared SPI bus" as spi <<optional>>
component "Button / switches" as controls
component "Potentiometer" as pot
component "LED" as led
component "Backlight" as backlight <<optional>>
mic --> cpu : microphone I²S link
cpu --> dac : DAC I²S link
cpu -- spi : SPI
spi -- display
spi -- touch
spi -- sd
controls --> cpu : GPIO
pot --> cpu : ADC
cpu --> led : GPIO
cpu --> backlight : PWM
legend bottom
  Grey elements are optional.
endlegend
@enduml
