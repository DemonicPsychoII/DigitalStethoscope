@startuml runtime_ownership
!pragma layout smetana
skinparam shadowing false
skinparam component {
 BackgroundColor<<optional>> #EEEEEE
 BorderColor<<optional>> #888888
 FontColor<<optional>> #666666
}
skinparam artifact {
 BackgroundColor<<optional>> #EEEEEE
 BorderColor<<optional>> #888888
 FontColor<<optional>> #666666
}
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
title Threads
top to bottom direction
skinparam component {
 BackgroundColor<<thread>> #DCEBFA
 BorderColor<<thread>> #345E87
 BackgroundColor<<interrupt>> #F0E5CF
}
component "GPIO ISR" as irq <<interrupt>>
component "GPIO / ADC adapters\nTouch adapter (optional)" as adapters
component "Input\nButtons / switches\nTouch (optional)" as inp <<thread>>
component "Main / controller" as ctl <<thread>>
component "Audio\nFilter\nCapture / slow replay (optional)" as audio <<thread>>
component "BPM\nWindow / aggregation" as bpm <<thread>>
component "Storage" as storage <<optional>>
component "Display" as display <<optional>>
component "Network" as net <<thread>>
irq --> inp : wake-up · semaphore
adapters --> inp : input samples · driver reads
inp --> ctl : control events · k_msgq
ctl --> audio : settings / commands · k_msgq
audio --> bpm : original-rate sample blocks\nbefore filter / gain · handles / k_msgq
bpm --> ctl : BPM result · k_msgq
audio --> ctl : completion / fault · k_msgq
ctl --> storage : file request · k_msgq
storage --> audio : file audio · block handles / k_msgq
ctl --> display : UI state · snapshot copy
ctl --> net : BPM result · k_msgq
net --> ctl : send outcome · k_msgq
legend bottom
  Grey / optional = beyond MVP.
  Display, touch, SD and capture / slower replay are optional.
endlegend
@enduml
