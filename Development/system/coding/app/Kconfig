mainmenu "DigitalStethoscope"

source "Kconfig.zephyr"

config STETHO_DEVKIT_LED_TEST
	bool "Blink the devkit RGB LED for a bench test"
	depends on DT_HAS_WORLDSEMI_WS2812_SPI_ENABLED
	select LED_STRIP
	help
	  Blink one green LED with one second on and one second off.
	  Select the matching devkit LED overlay and disconnect the carrier
	  and external peripherals before this test.
