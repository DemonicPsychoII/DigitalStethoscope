mainmenu "DigitalStethoscope"

config PHYSICALINTERFACE_VOLUME_POTENTIOMETER_FITTED
	bool "Volume potentiometer J7 fitted"
	depends on ADC
	default y
	help
	  Read the volume potentiometer on GPIO1, ADC1 channel 0. Turn this off
	  only for a carrier without J7: L1_PHYSICALINTERFACE then does not read
	  the ADC and reports the volume as absent, because an unfitted wiper
	  floats and its readings mean nothing.

source "Kconfig.zephyr"
