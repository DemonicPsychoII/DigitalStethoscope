@startuml state_machines_control_interface
!theme cyborg
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
skinparam state {
 BackgroundColor #16324a
 BorderColor #4aa3df
 FontColor #e6edf7
 BackgroundColor<<terminal>> #3a1d22
 BorderColor<<terminal>> #e06c75
 BackgroundColor<<finding>> #3a2a12
 BorderColor<<finding>> #e5a50a
 BackgroundColor<<documented>> #273241
 BorderColor<<documented>> #61738a
 FontColor<<documented>> #b8c4d4
}
skinparam note {
 BackgroundColor #1b2330
 BorderColor #61738a
 FontColor #e6edf7
}
hide empty description
title Button, CONTROL and status light: how does a contact become a command and a light?\n(implemented; physicalinterface.c, control.c; documented session machine not implemented)
state "Button (system work queue)" as Button {
  state "Released\nisButtonPressed = false" as Released
  state "Pressed, long press pending\nlong-press work scheduled 2 s" as Pressed
  state "Long press reported\nisLongPressReported" as LongReported
  [*] --> Released : baseline read at init\n(held at boot: Long press reported)
  Released --> Pressed : debounced level low (30 ms after the last edge)
  Pressed --> Released : debounced release: cancel long-press work;\nreport SHORT_PRESS
  Pressed --> LongReported : 2 s: report LONG_PRESS
  LongReported --> Released : debounced release, no event
}
state "CONTROL (control.c)" as Control {
  state "Startup\nisIdle = false, lamp test" as Startup
  state "Idle\nisIdle = true (never left)" as Idle
  [*] --> Startup
  Startup --> Idle : control_completeStartup
  Startup --> Startup : LONG_PRESS: INPUT_REJECTED dim
  Idle --> Idle : LONG_PRESS: postEvent(SETUP_REQUESTED)\nSHORT_PRESS: ignored
}
state "Wi-Fi indication (wifiIndication, flash-end work)" as Indication {
  state "IDLE light\nwifiIndication = NONE" as IdleLight
  state "WIFI_CONNECTING or PORTAL_OPEN" as WiFiLight
  state "Three quick flashes\n1.5 s, then the indication" as Flash
  [*] --> IdleLight
  IdleLight --> WiFiLight : CONNECTING or PORTAL_OPEN
  WiFiLight --> IdleLight : any other code, including errors (D3)
  IdleLight --> Flash : WIFI_CONNECTED [isIdle]
  WiFiLight --> Flash : WIFI_CONNECTED [isIdle]
  Flash --> IdleLight : flash-end work
}
state "Status light (statusLight under spinlock)" as Light {
  state "Base pattern\ncolour, pattern, start time;\nanimated patterns re-render every 20 ms" as Base
  state "Rejection overlay\n50 % for 250 ms" as Overlay
  [*] --> Base
  Base --> Overlay : INPUT_REJECTED
  Overlay --> Base : overlay end
}
note bottom of Control
 **Documented, not implemented:** Start/Stop session, Busy admission, short-press acknowledgement
 (architecture session statechart). D5: a long press during setup or with a latched cleanup fault is
 dropped by COMMUNICATION without a rejection light; postEvent still returns 0.
end note
@enduml
