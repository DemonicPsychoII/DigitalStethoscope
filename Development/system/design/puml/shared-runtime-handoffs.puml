@startuml shared_runtime_handoffs
!theme cyborg
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #0b1018
skinparam defaultFontColor #e6edf7
skinparam ArrowColor #a9b8ca
skinparam component {
 BackgroundColor<<thread>> #16324a
 BorderColor<<thread>> #4aa3df
 FontColor<<thread>> #e6edf7
 BackgroundColor<<interrupt>> #3a3020
 BorderColor<<interrupt>> #c9a35a
 FontColor<<interrupt>> #f0e5cf
}
skinparam queue {
 BackgroundColor<<handoff>> #12384a
 BorderColor<<handoff>> #4aa3df
 FontColor<<handoff>> #e6edf7
}
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
title Threads and bounded handoffs: what happens when the receiver falls behind?
top to bottom direction
component "GPIO ISR" as irq <<interrupt>>
component "Input\nL1_PHYSICALINTERFACE\nbuttons / switches / volume" as inp <<thread>>
component "Shell\nL2_SHELL" as shell <<thread>>
component "Controller\nL2_CONTROL\nonly writer of mode state" as ctl <<thread>>
component "Audio\nL2_AUDIO · L1_I2S, L1_FILTER" as audio <<thread>>
component "BPM worker\nL2_AUDIO · L1_FILTER, L1_BPM" as bpm <<thread>>
component "Communication\nL2_COMMUNICATION\nL1_FHIR, L1_WIFI, L1_STORAGE" as net <<thread>>
component "Portal HTTP server\nL1_PORTAL" as portal <<thread>>

queue "Control events · values\nk_msgq, 16 (P11)\nfull: reconcile stable values,\nreject + report transient actions" as controlEvents <<handoff>>
queue "Audio command · values\nk_msgq" as audioCommands <<handoff>>
queue "Analysis blocks · copied payloads + handles\nbounded pool\nfull: mark gap, reset window;\nlistening continues" as analysisBlocks <<handoff>>
queue "Results / completion / faults · values\nposted without waiting" as workerEvents <<handoff>>
queue "State snapshot · value copy\nslow reader: latest snapshot wins" as snapshots <<handoff>>
queue "Listening / setup request · values\nspinlock flags + semaphore\nlatest Start / Stop wins;\nrelease confirmed through a\nsynchronized stopped state" as listeningRequest <<handoff>>
queue "Delivery job · value copy\n1 slot (P11); occupied: Busy,\nno overwrite, no retry queue" as deliveryJob <<handoff>>
queue "Wi-Fi feedback / delivery outcome · values\ncallback on the\ncommunication thread; outcome read\nunder spinlock" as networkFeedback <<handoff>>
queue "Portal requests · values\nring of 4 (P24) + semaphore\nfull: HTTP 503, Retry-After 1 s" as portalRequests <<handoff>>

irq --> inp : wake-up
inp --> controlEvents
shell --> controlEvents
controlEvents --> ctl
ctl --> audioCommands
audioCommands --> audio
audio --> analysisBlocks
analysisBlocks --> bpm
bpm --> workerEvents
audio --> workerEvents
workerEvents --> ctl
ctl --> snapshots
snapshots --> shell
ctl --> listeningRequest
listeningRequest --> net
ctl --> deliveryJob
deliveryJob --> net
net --> networkFeedback
networkFeedback --> ctl
portal --> portalRequests
portalRequests --> net
legend bottom
 Each handoff states its own overload rule. Values are copied; handles point into a bounded pool.
endlegend
@enduml
