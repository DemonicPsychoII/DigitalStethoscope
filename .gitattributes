# Store text with LF so checkouts on Windows, Linux and the CI guests produce identical diffs.
* text=auto eol=lf
# Windows-only scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
# Binary evidence and documents are never converted.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.bin binary
*.elf binary
*.zip binary
*.xlsx binary
*.docx binary
# PlantUML renders are regenerated from their .puml sources; validate_docs.py checks them,
# so reviews collapse them and git diff skips their content.
**/rendered/*.svg linguist-generated=true -diff
