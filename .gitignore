.vscode/*

# Zephyr toolchain workspace (west modules, SDK, venv, binary blobs).
# Several GB of third-party content - recreate it with:
#   tools/toolchain/setup-toolchain.ps1 -WorkspacePath <existing-directory>
# Keep existing installations in place; script relocation does not relocate SDKs.
Development/system/coding/tools/zephyrproject/
Development/Toolchain/zephyrproject/

# Zephyr / CMake build output
build/
build-*/
twister-out*/
.ci-workspace/
.ci-hash-tmp/
artifacts/
*.elf
*.map
*.bin

# Python
__pycache__/
*.py[cod]
.venv/
venv/

